@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="empty-state error-state">
    <p class="eyebrow">@(Model.Code > 0 ? "Error " + Model.Code : "Error")</p>
    <h1>@Model.Title</h1>
    <p>@Model.Message</p>
    <a class="btn btn-raceday" asp-controller="Home" asp-action="Index">Back to events</a>
</div>