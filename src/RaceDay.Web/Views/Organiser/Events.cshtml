@model List<ApiEvent>
@{ ViewData["Title"] = "My Events"; }
<div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <p class="eyebrow">Organiser</p>
        <h1>My Events</h1>
    </div>
    <a class="btn btn-raceday" asp-action="CreateEvent">+ Create event</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>You have not created any events yet</h3>
        <p>Create an event, add categories and start taking enrolments.</p>
        <a class="btn btn-raceday" asp-action="CreateEvent">Create an event</a>
    </div>
}
else
{
    <div class="panel p-0">
        <div class="table-responsive">
            <table class="table table-raceday align-middle mb-0">
                <thead><tr><th></th><th>Event</th><th>Date</th><th>Distance</th><th>Categories</th><th class="text-center">Enrolments</th><th></th></tr></thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td class="thumb-cell">
                                @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                                {
                                    <img class="thumb" src="@ev.BannerImageUrl" alt="" />
                                }
                                else
                                {
                                    <div class="thumb thumb-placeholder @UiHelpers.TypeClass(ev.EventType)"></div>
                                }
                            </td>
                            <td><strong>@ev.EventName</strong><br /><small class="text-muted">@ev.Location &middot; @ev.EventType</small></td>
                            <td>@UiHelpers.Date(ev.EventDate)</td>
                            <td>@UiHelpers.Km(ev.DistanceKM)</td>
                            <td>@(ev.Categories?.Count ?? 0)</td>
                            <td class="text-center"><span class="count-pill">@(ev.EnrolmentCount ?? 0)</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-raceday btn-sm" asp-action="EditEvent" asp-route-id="@ev.EventID">Edit</a>
                                <a class="btn btn-outline-raceday btn-sm" asp-controller="Categories" asp-action="Index" asp-route-eventId="@ev.EventID">Categories</a>
                                <form asp-action="DeleteEvent" asp-route-id="@ev.EventID" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}