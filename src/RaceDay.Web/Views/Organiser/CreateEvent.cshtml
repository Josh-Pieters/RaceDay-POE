@model EventFormViewModel
@{ ViewData["Title"] = "Create event"; }
<div class="page-header">
    <p class="eyebrow">Organiser</p>
    <h1>Create an event</h1>
</div>
<div class="panel">
    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data" novalidate>
        <partial name="_EventFields" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-raceday">Create event</button>
            <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}