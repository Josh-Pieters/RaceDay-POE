@model EventFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="EventName" class="form-label"></label>
        <input asp-for="EventName" class="form-control" />
        <span asp-validation-for="EventName" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="">Choose...</option>
            @foreach (var t in Lookups.EventTypes)
            {
                <option value="@t" selected="@(Model.EventType == t)">@t</option>
            }
        </select>
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StartTime" class="form-label"></label>
        <input asp-for="StartTime" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DistanceKM" class="form-label"></label>
        <input asp-for="DistanceKM" type="number" step="0.1" min="0.1" class="form-control" />
        <span asp-validation-for="DistanceKM" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Province" class="form-label"></label>
        <select asp-for="Province" class="form-select">
            <option value="">Choose...</option>
            @foreach (var p in Lookups.Provinces)
            {
                <option value="@p" selected="@(Model.Province == p)">@p</option>
            }
        </select>
        <span asp-validation-for="Province" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Banner" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentBannerUrl))
        {
            <div class="banner-preview mb-2"><img src="@Model.CurrentBannerUrl" alt="Current banner" /><small class="text-muted">Current banner - choose a new file to replace it.</small></div>
        }
        <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
        <div class="form-text">JPG, PNG or WebP, up to 5 MB. It is stored in Azure Blob Storage.</div>
    </div>
</div>