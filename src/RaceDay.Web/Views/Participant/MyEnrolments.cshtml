@model List<ApiEnrolment>
    @{ ViewData["Title"] = "My Enrolments"; }
    <div class="page-header">
        <p class="eyebrow">Participant</p>
        <h1>My Enrolments</h1>
    </div>
    @if (!Model.Any())
{
    <div class="empty-state">
        <h3>You have not entered any events yet</h3>
        <p>Browse the race calendar and pick your next challenge.</p>
        <a class="btn btn-raceday" asp-controller="Home" asp-action="Index">Find events</a>
    </div>
}
else
{
    <div class="panel p-0">
        <div class="table-responsive">
            <table class="table table-raceday align-middle mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th>Enrolled on</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">@e.EventName</a></td>
                        <td>@UiHelpers.Date(e.EventDate)</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            @if (e.Status == Lookups.Confirmed && e.Result == null)
                                {
                            <form asp-action="CancelEnrolment" asp-route-id="@e.EnrolmentID" method="post" class="d-inline"
                                  onsubmit="return confirm('Cancel this enrolment?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                            </form>
                                }
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
