@model CategoriesViewModel
@{ ViewData["Title"] = "Categories"; }
<partial name="_EventTabs" model='new EventTabsModel(Model.Event.EventID, Model.Event.EventName, "Categories")' />
<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel p-0">
            <div class="panel-title">Categories</div>
            @if (Model.Event.Categories == null || !Model.Event.Categories.Any())
            {
            <div class="empty-state border-0">
                <h3>No categories yet</h3>
                <p>Add age or distance categories (for example Under 20, Senior, 10 km, 21 km).</p>
            </div>
            }
            else
            {
            <div class="table-responsive">
                <table class="table table-raceday align-middle mb-0">
                    <thead><tr><th>Category</th><th>Distance</th><th>Price</th><th>Max</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Event.Categories)
                            {
                        <tr>
                            <td><strong>@c.CategoryName</strong></td>
                            <td>@UiHelpers.Km(c.DistanceKM)</td>
                            <td>@UiHelpers.Money(c.Price)</td>
                            <td>@c.MaxParticipants</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-raceday btn-sm" asp-action="Edit" asp-route-id="@c.CategoryID" asp-route-eventId="@Model.Event.EventID">Edit</a>
                                <form asp-action="Delete" asp-route-id="@c.CategoryID" asp-route-eventId="@Model.Event.EventID" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel">
            <h2>Add a category</h2>
            <form asp-action="Add" method="post" novalidate>
                <input type="hidden" asp-for="NewCategory.EventID" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                    <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g. Under 20, Senior, 21 km" />
                    <span asp-validation-for="NewCategory.CategoryName" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="NewCategory.DistanceKM" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKM" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="NewCategory.DistanceKM" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.Price" class="form-label"></label>
                        <input asp-for="NewCategory.Price" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.Price" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
                        <input asp-for="NewCategory.MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-raceday w-100 mt-3">Add category</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}