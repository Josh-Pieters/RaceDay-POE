@model CategoryFormViewModel
@{ ViewData["Title"] = "Edit category"; }
<div class="page-header">
    <p class="eyebrow">@(ViewData["EventName"] ?? "Event")</p>
    <h1>Edit category</h1>
</div>
<div class="panel narrow-panel">
    <form asp-action="Edit" asp-route-id="@Model.CategoryID" method="post" novalidate>
        <input type="hidden" asp-for="CategoryID" />
        <input type="hidden" asp-for="EventID" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>
        <div class="row g-3">
            <div class="col-6">
                <label asp-for="DistanceKM" class="form-label"></label>
                <input asp-for="DistanceKM" type="number" step="0.1" min="0.1" class="form-control" />
                <span asp-validation-for="DistanceKM" class="text-danger"></span>
            </div>
            <div class="col-6">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="MaxParticipants" class="form-label"></label>
                <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-raceday">Save changes</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="@Model.EventID">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}